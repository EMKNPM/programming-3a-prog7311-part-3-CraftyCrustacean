@model IReadOnlyList<GLMS.Commands.ICommand>

@{
    ViewData["Title"] = "Command History";
}

<h1>Command History</h1>
<p class="text-muted">Actions performed on service requests, most recent last.</p>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No commands have been executed yet.</div>
}
else
{
    <ol class="list-group list-group-numbered">
        @foreach (var command in Model)
        {
            <li class="list-group-item">@command.Description</li>
        }
    </ol>
}

<p class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Service Requests</a>
</p>