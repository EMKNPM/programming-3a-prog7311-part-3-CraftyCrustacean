@model GLMS.Models.ServiceRequest

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["successMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["errorMessage"]</div>
}

<div>
    <h4>ServiceRequest</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Contract)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contract)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Discription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Discription)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CostUSD)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CostUSD)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CostZAR)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CostZAR)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExchangeRateUsed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ExchangeRateUsed)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
    </dl>
    <p class="text-muted small mt-3">
        <a href="https://www.exchangerate-api.com" target="_blank" rel="noopener">Rates By Exchange Rate API</a>
    </p>
</div>
<div>
    @if (Model?.Status == GLMS.Models.ServiceRequestStatus.Pending)
    {
        <div class="card mt-3">
            <div class="card-header">Actions</div>
            <div class="card-body">
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">Approve</button>
                </form>

                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="text" name="reason" placeholder="Rejection reason"
                           class="form-control d-inline-block" style="width: 300px;" />
                    <button type="submit" class="btn btn-danger">Reject</button>
                </form>

                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">Cancel</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">
            This request has status <strong>@Model?.Status</strong>. No further actions available.
        </div>
    }
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
