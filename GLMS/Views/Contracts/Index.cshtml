@model GLMS.ApiClient.ContractFilterDto

@{
    ViewData["Title"] = "Contracts";
    var results = ViewBag.Results as IEnumerable<GLMS.ApiClient.ContractDto> ?? Enumerable.Empty<GLMS.ApiClient.ContractDto>();
}

<h1>Contracts</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="card mb-3">
    <div class="card-header">Search & Filter</div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label asp-for="StartDateFrom" class="form-label"></label>
                <input asp-for="StartDateFrom" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="StartDateTo" class="form-label"></label>
                <input asp-for="StartDateTo" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<GLMS.ApiClient.ContractStatus>()">
                    <option value="">-- Any Status --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">Apply</button>
                <a asp-action="Index" class="btn btn-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">
    Showing <strong>@results.Count()</strong> contract(s).
</p>

<table class="table">
    <thead>
        <tr>
            <th>Client</th>
            <th>Service Level</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in results)
        {
            <tr>
                <td>@item.ClientName</td>
                <td>@item.ServiceLevel</td>
                <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>